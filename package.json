{
  "name": "timetable-to-calendar",
  "private": true,
  "version": "0.1.0",
  "description": "将中央财经大学教务课表 PDF、HTML 和 JSON 转换为日历的本地解析工具。",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "type": "module",
  "scripts": {
    "prepare:pdf": "node scripts/prepare-pdf-assets.mjs",
    "predev": "npm run prepare:pdf",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:pdf",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "linkedom": "^0.18.12",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ical.js": "^2.2.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
